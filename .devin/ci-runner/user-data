#cloud-config
hostname: bsuite-ci-preflight
manage_etc_hosts: true
ssh_pwauth: false
disable_root: true
users:
  - name: ci
    lock_passwd: true
    shell: /bin/bash
package_update: false
package_upgrade: false
runcmd:
  - [sh, -ec, "test \"$(nproc)\" -eq 4; test ! -d /home/braden; printf 'BSUITE_VM_OFFLINE_READY\\n' > /dev/ttyS0"]
power_state:
  delay: now
  mode: poweroff
  message: Offline preflight complete
  timeout: 60
  condition: true
