#cloud-config
hostname: bsuite-ci-netpreflight
manage_etc_hosts: true
ssh_pwauth: false
disable_root: true
users:
  - name: ci
    lock_passwd: true
    shell: /bin/bash
package_update: false
package_upgrade: false
runcmd:
  - - sh
    - -ec
    - |
      false
      curl --proxy http://10.0.2.100:3128 --noproxy '' --fail --silent --show-error --max-time 30 https://github.com/robots.txt >/dev/null
      printf 'PASS github proxy\n' > /dev/ttyS0
      test "$(curl --proxy http://10.0.2.100:3128 --noproxy '' -s -o /dev/null -w '%{http_code}' --max-time 15 http://127.0.0.1/)" = 403
      printf 'PASS localhost denied\n' > /dev/ttyS0
      test "$(curl --proxy http://10.0.2.100:3128 --noproxy '' -s -o /dev/null -w '%{http_code}' --max-time 15 http://169.254.169.254/)" = 403
      printf 'PASS metadata denied\n' > /dev/ttyS0
      test "$(curl --proxy http://10.0.2.100:3128 --noproxy '' -s -o /dev/null -w '%{http_code}' --max-time 15 http://example.com/)" = 403
      printf 'PASS unapproved domain denied\n' > /dev/ttyS0
      if curl --noproxy '*' --connect-timeout 2 --max-time 3 -s http://10.0.2.2:43128 >/dev/null 2>&1; then printf 'FAIL direct connection unexpectedly succeeded\n' > /dev/ttyS0; exit 1; fi
      printf 'PASS direct host denied\n' > /dev/ttyS0
      if curl --noproxy '*' --connect-timeout 2 --max-time 3 -s https://github.com/robots.txt >/dev/null 2>&1; then printf 'FAIL direct connection unexpectedly succeeded\n' > /dev/ttyS0; exit 1; fi
      printf 'PASS direct public denied\n' > /dev/ttyS0
      test ! -d /home/braden
      printf 'BSUITE_VM_RESTRICTED_NETWORK_READY\n' > /dev/ttyS0
power_state:
  delay: now
  mode: poweroff
  message: Restricted-network preflight complete
  timeout: 60
  condition: true
