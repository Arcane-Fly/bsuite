#cloud-config
hostname: bsuite-ci-tooling
manage_etc_hosts: true
ssh_pwauth: false
disable_root: true
users:
  - name: ci
    lock_passwd: true
    shell: /bin/bash
package_update: false
package_upgrade: false
runcmd:
  - - bash
    - -euo
    - pipefail
    - -c
    - |
      exec > >(tee /dev/ttyS0) 2>&1
      export http_proxy=http://10.0.2.100:3128 https_proxy=http://10.0.2.100:3128 HTTP_PROXY=http://10.0.2.100:3128 HTTPS_PROXY=http://10.0.2.100:3128 no_proxy=localhost,127.0.0.1 NO_PROXY=localhost,127.0.0.1 DEBIAN_FRONTEND=noninteractive
      apt-get update
      apt-get install -y ca-certificates curl git jq unzip zip xz-utils tar build-essential python3 python3-venv python3-pip gh docker.io libicu74 libssl3t64 libkrb5-3 zlib1g liblttng-ust1t64
      curl -fL --retry 2 --max-time 300 https://nodejs.org/dist/v24.14.0/node-v24.14.0-linux-x64.tar.xz -o /var/tmp/node.tar.xz
      printf '%s  %s\n' 41cd79bb7877c81605a9e68ec4c91547774f46a40c67a17e34d7179ef11729df /var/tmp/node.tar.xz | sha256sum -c -
      tar -xJf /var/tmp/node.tar.xz -C /usr/local --strip-components=1
      mkdir -p /opt/actions-runner
      curl -fL --retry 2 --max-time 300 https://github.com/actions/runner/releases/download/v2.337.0/actions-runner-linux-x64-2.337.0.tar.gz -o /var/tmp/runner.tar.gz
      printf '%s  %s\n' 70920811a4f8ad4328818682bca5c6469c1c942fab52448868071d0063816613 /var/tmp/runner.tar.gz | sha256sum -c -
      tar -xzf /var/tmp/runner.tar.gz -C /opt/actions-runner
      chown -R ci:ci /opt/actions-runner
      usermod -aG docker ci
      corepack enable
      corepack prepare pnpm@10.33.3
      corepack prepare pnpm@11.24.0 --activate
      test "$(node --version)" = v24.14.0
      test "$(runuser -u ci -- /opt/actions-runner/bin/Runner.Listener --version)" = 2.337.0
      node --version
      corepack --version
      pnpm --version
      git --version
      gh --version
      docker --version
      python3 --version
      test ! -e /opt/actions-runner/.credentials
      test ! -e /opt/actions-runner/.runner
      printf 'BSUITE_CI_TOOLING_PREPARED_UNREGISTERED\n' > /dev/ttyS0
power_state:
  delay: now
  mode: poweroff
  message: BSuite CI tooling preparation complete
  timeout: 60
  condition: true
