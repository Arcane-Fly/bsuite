# (may be consumed via a shared SDK that reads them). Confirm before deleting.
# =============================================================================
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""                            # SERVER-ONLY


# =============================================================================
# EMAIL / RESEND
# =============================================================================
RESEND_API_KEY="re_xxx"                           # SERVER-ONLY
EMAIL_FROM=""                                     # [braden] [business-suite]
EMAIL_HOST=""                                     # [braden] (SMTP)
EMAIL_USER=""                                     # [braden]
EMAIL_PASSWORD=""                                 # [braden] SERVER-ONLY
EMAIL_PORT="587"                                  # [braden]


# =============================================================================
# VERCEL BLOB + KV (Upstash Redis)
