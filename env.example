# =============================================================================
AI_GATEWAY_API_KEY=""
JODIE_AI_MODEL_SLUG=""


# =============================================================================
# APP URLS / CROSS-APP WIRING
# Used by: various
# =============================================================================
NEXT_PUBLIC_APP_URL=""                            # [conduit]
NEXT_PUBLIC_APP_NAME=""                           # [conduit]
NEXT_PUBLIC_BSU_URL=""                            # [conduit] → business-suite URL
NEXT_PUBLIC_BSU_OAUTH_CLIENT_ID=""                # [conduit] OAuth client
VITE_R8_URL=""                                    # [crm7]? cross-link to r8
VITE_APP_URL=""                                   # canonical app base URL for Vite apps
VITE_ALLOWED_DOMAINS=""
VITE_DEVELOPER_EMAILS=""
VITE_PLATFORM_KIT_ADMIN_ENABLED=""
CORS_ORIGINS=""                                   # [braden]


# =============================================================================
# SLACK
# Declared by: [braden] [business-suite] — verify code usage
# =============================================================================
SLACK_APP_ID=""
SLACK_CLIENT_ID=""
# SLACK_CLIENT_SECRET / SIGNING_SECRET — add if you post to Slack from server


