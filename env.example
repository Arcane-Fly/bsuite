# =============================================================================
# BSuite — Unified .env.example
# =============================================================================
# Generated 2026-04-24 by env audit across 6 Vercel projects + 6 repos.
# Legend for per-variable usage tags:
#   [braden]  [crm7]  [business-suite]  [r8]  [conduit]  [throughput]
# Tag meaning:
#   used            = referenced in source code
#   required        = code will crash without it (no fallback)
#   optional        = code has fallback/null-safe path
#   build-only      = consumed by CI, migrations, or build scripts (not app runtime)
#   server-only     = never expose to browser (no VITE_ / NEXT_PUBLIC_ prefix)
# =============================================================================


# =============================================================================
# SUPABASE — Auth via JWKS (asymmetric, RS256/ES256); PKCE flows
# Used by: [braden] [crm7] [business-suite] [r8] [conduit] [throughput]
# Conduit is Next.js → NEXT_PUBLIC_*; all others are Vite → VITE_*.
# Token verification uses getClaims() against /.well-known/jwks.json.
# No HS256 path exists; SUPABASE_JWT_SECRET is NOT referenced anywhere — delete.
# =============================================================================

# ---- Public URL + publishable key (client-safe, ships to browser) ----
# Vite projects [braden] [crm7] [business-suite] [r8] [throughput]
VITE_SUPABASE_URL="https://<ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# Next.js project [conduit]
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# ---- Server-only (edge functions, API routes, scripts) ----
# Used by: [braden] [crm7] [business-suite] [r8] [conduit] [throughput]
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_xxx"               # replaces legacy SERVICE_ROLE_KEY

# ---- Storage S3 (supabase storage as S3-compatible bucket) ----
# Used by: [business-suite] [r8] [throughput] — declared only, confirm runtime usage
SUPABASE_BUCKET_ENDPOINT_URL=""
SUPABASE_BUCKET_REGION=""
SUPABASE_BUCKET_ACCESS_KEY_ID=""
SUPABASE_BUCKET_SECRET_ACCESS_KEY=""

# ---- Supabase Management / CLI (build-only) ----
# Used by: [business-suite] CLI migrations, seed scripts
SUPABASE_ACCESS_TOKEN="sbp_xxx"                   # personal access token
SBP_MGMT_TOKEN="sbp_xxx"                          # platform-kit-proxy mgmt API token (SUPABASE_* is a reserved Edge Function prefix)
SUPABASE_PROJECT_REF="<ref>"                      # used by [crm7] [business-suite]

# ---- DEPRECATED — delete from Vercel ----
# SUPABASE_ANON_KEY                   # rename → SUPABASE_PUBLISHABLE_KEY or delete
# SUPABASE_SERVICE_ROLE_KEY           # rename → SUPABASE_SECRET_KEY
# SUPABASE_JWT_SECRET                 # HS256 artefact; unreferenced; delete
# SUPABASE_PUBLISHABLE_KEY            # duplicate of VITE_/NEXT_PUBLIC_ variant
# VITE_PUBLIC_SUPABASE_URL            # redundant VITE_ + PUBLIC_ prefix
# VITE_PUBLIC_SUPABASE_ANON_KEY       # redundant + wrong name
# VITE_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# VITE_SUPABASE_ANON_KEY              # replaced by VITE_SUPABASE_PUBLISHABLE_KEY
# VITE_APP_DOMAIN                     # replaced by VITE_APP_URL
# VITESUPABASE_ANON_KEY               # TYPO in [throughput] — delete immediately


# =============================================================================
# POSTGRES — direct DB connection (build-time / migrations only)
# Declared by: [braden] [crm7] [business-suite] [r8] [conduit] [throughput]
# Used by: NONE of the app runtime code references these directly.
# Likely consumed by: Prisma/Drizzle/supabase-cli migrations in CI.
# Keep only where a migration pipeline actually runs; delete elsewhere.
# =============================================================================
POSTGRES_URL="postgres://...pooler...:6543/postgres?sslmode=require"
POSTGRES_URL_NON_POOLING="postgres://...pooler...:5432/postgres?sslmode=require"
POSTGRES_PRISMA_URL="postgres://...?pgbouncer=true"
POSTGRES_HOST=""
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DATABASE="postgres"


# =============================================================================
# STRIPE — payments
# Used by: [crm7] [business-suite] (and possibly r8)
# =============================================================================
STRIPE_PUBLISHABLE_KEY="pk_live_xxx"              # safe to expose
STRIPE_SECRET_KEY="sk_live_xxx"                   # SERVER-ONLY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_xxx"  # conduit convention

# ---- CRITICAL BUG ----
# VITE_STRIPE_SECRET_KEY is declared in [business-suite] Vercel env.
# A VITE_-prefixed secret key is inlined into the CLIENT BUNDLE and shipped
# to every browser. DELETE IMMEDIATELY and rotate the Stripe secret.
# VITE_STRIPE_PUBLIC_KEY / VITE_STRIPE_SECRET_KEY              # DELETE


# =============================================================================
# XERO — accounting sync (CRM7 only currently)
# Used by: [crm7] — both Vite client-side and Supabase Edge Functions
# =============================================================================
XERO_CLIENT_ID="xxx"
XERO_CLIENT_SECRET="xxx"                          # SERVER-ONLY
XERO_REDIRECT_URI="https://crm.crm7.app/auth/xero/callback"

# ---- CRITICAL BUG ----
# VITE_XERO_CLIENT_SECRET is referenced in:
#   crm7/src/lib/pipelines/xeroInvoiceAdapter.ts:62
# This pipeline runs on a Vite path — the secret would ship to the browser
# if ever populated. Move this adapter behind a server route/edge function
# and delete VITE_XERO_CLIENT_SECRET. Rotate the Xero secret after fix.
# VITE_XERO_CLIENT_ID — acceptable if kept in client-side OAuth start flow.


# =============================================================================
# FAIRWORK — Fair Work Commission MAPD API
# Used by: [r8] [business-suite] — Supabase Edge Functions (Deno)
# [crm7] declares FAIRWORK_API_KEY but does NOT use it in code. Dead config.
# [r8] declares FAIRWORK_API_KEY_1 / _2 / _URL — used by nothing in repo.
# =============================================================================
FAIRWORK_API_KEY="xxx"                            # primary (used in edge fns)
FAIRWORK_API_KEY_SECONDARY="xxx"                  # declared; verify failover code

# ---- DEPRECATED ----
# FAIRWORK_API_KEY_1 / FAIRWORK_API_KEY_2 (r8)    # unreferenced; delete
# FAIRWORK_API_URL                                # unreferenced; delete


# =============================================================================
# RAM — ATO Relationship Authorisation Manager (M2M mTLS credentials)
# Used by: [crm7] src/lib/integrations/ram/createRamClientFromEnv.ts
#
# *** BROKEN: declared in source code but NOT present in any Vercel env. ***
# Any call path that invokes createRamClientFromEnv() in production will fail
# at runtime with missing-env errors. Add all 7 vars to crm7 Vercel project.
# =============================================================================
RAM_CREDENTIAL_ENVIRONMENT="production"           # or "evte"
RAM_CLIENT_ID="ABRD:<abn>_crm7"
RAM_CREDENTIAL_ABN="21662181740"
RAM_CREDENTIAL_EXPIRES_AT="2028-03-02T17:06:58.000Z"
RAM_PRIVATE_KEY_PKCS8_B64=""                      # PKCS#8 DER private key, base64
RAM_LEAF_CERT_B64=""                              # X.509 DER leaf cert, base64
RAM_TOKEN_ENDPOINTS=""                            # JSON map of env→token endpoint URLs


# =============================================================================
# GOOGLE — OAuth + Cloud APIs
# Used by: [crm7] [business-suite] (declared + used); [r8] declared only
# =============================================================================
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxx"                 # SERVER-ONLY
GOOGLE_API_KEY="AIzaSy..."                        # restrict by HTTP referrer
GOOGLE_CLOUD_PROJECT_ID=""
# Extras referenced in code but not declared on Vercel (verify usage):
# GOOGLE_DOC_ID                                   # [crm7]
# GOOGLE_SCOPES                                   # [crm7]
# GOOGLE_SERVICE_ACCOUNT_JSON                     # [crm7]
# GOOGLE_EMAIL_CLIENT_ID / CLIENT_SECRET          # [business-suite]
# GOOGLE_GENERATIVE_AI_API_KEY                    # [conduit]


# =============================================================================
# AZURE / MICROSOFT ENTRA — OAuth
# Declared by: [crm7] [business-suite] [r8]
