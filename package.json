{
  "name": "bsuite",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "lint:all": "for dir in crm7 R80.4 braden business-suite-unified conduit; do echo \"\\n=== Linting $dir ===\"; (cd $dir && pnpm lint) || exit 1; done",
    "lint:ai-gateway": "node scripts/check-ai-gateway-compliance.mjs",
    "lint:no-cookie-sso": "node scripts/check-no-cookie-sso.mjs",
    "lint:supabase-client-init": "node scripts/check-supabase-client-init.mjs",
    "lint:node-pin-parity": "node scripts/check-node-pin-parity.mjs",
    "lint:lockfile-hygiene": "node scripts/check-lockfile-hygiene.mjs",
    "lint:own-package-freshness": "node scripts/check-own-package-freshness.mjs",
    "lint:tailwind-v4": "node scripts/check-tailwind-v4.mjs",
    "lint:vercel-production": "node scripts/check-vercel-production-readiness.mjs",
    "supabase:manifest": "node scripts/supabase/generate-schema-manifest.mjs > supabase/schema-manifest.json",
    "supabase:preview-plan": "node scripts/supabase/plan-preview-db.mjs --markdown",
    "supabase:rehearse": "bash scripts/supabase/rehearse-local.sh",
    "supabase:rehearse:keep": "bash scripts/supabase/rehearse-local.sh --keep",
    "supabase:rehearse:stop": "bash scripts/supabase/rehearse-local.sh --stop",
    "test:all": "for dir in crm7 R80.4 braden business-suite-unified conduit; do echo \"\\n=== Testing $dir ===\"; (cd $dir && pnpm test -- --run) || exit 1; done",
    "build:all": "for dir in crm7 R80.4 braden business-suite-unified conduit; do echo \"\\n=== Building $dir ===\"; (cd $dir && pnpm build) || exit 1; done",
    "typecheck:all": "for dir in crm7 R80.4 braden business-suite-unified conduit; do echo \"\\n=== Typechecking $dir ===\"; (cd $dir && pnpm tsc --noEmit) || exit 1; done",
    "test:packages": "pnpm -r --filter './packages/*' test -- --run",
    "lint:migration-fk-indexes": "node scripts/check-migration-fk-indexes.mjs"
  },
  "dependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "typescript-eslint": "^8.68.0"
  }
}
