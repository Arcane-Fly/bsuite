# Conduit — Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase (shared BSuite project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App
NEXT_PUBLIC_APP_NAME=Conduit
NEXT_PUBLIC_APP_URL=http://localhost:5680

# BSU SSO OAuth Client (optional — for cross-app SSO)
NEXT_PUBLIC_BSU_OAUTH_CLIENT_ID=
NEXT_PUBLIC_BSU_URL=https://suite.crm7.app
