{
  "name": "@bsuite/design-tokens",
  "version": "0.1.0",
  "type": "module",
  "license": "UNLICENSED",
  "description": "Shared design tokens for all BSuite apps — spacing, typography, shadows, radius, motion, and the D2C Neon Electric palette.",
  "repository": {
    "type": "git",
    "url": "https://github.com/GaryOcean428/bsuite.git",
    "directory": "packages/design-tokens"
  },
  "files": [
