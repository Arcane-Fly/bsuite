    "./css/dark": "./src/css/dark.css",
    "./css/motion": "./src/css/motion.css",
    "./css/typography": "./src/css/typography.css",
    "./css/all": "./src/css/all.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
