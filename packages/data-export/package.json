{
  "name": "@bsuite/data-export",
  "version": "1.0.0",
  "description": "Shared BSuite data export/import primitives for CSV, XLSX, and JSON. Pure logic, zero React, zero Supabase.",
  "type": "module",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GaryOcean428/bsuite.git",
    "directory": "packages/data-export"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./csv": {
      "import": "./dist/csv/index.js",
      "types": "./dist/csv/index.d.ts"
    },
    "./xlsx": {
      "import": "./dist/xlsx/index.js",
      "types": "./dist/xlsx/index.d.ts"
    },
    "./json": {
      "import": "./dist/json/index.js",
      "types": "./dist/json/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser/index.js",
      "types": "./dist/browser/index.d.ts"
    },
    "./mappings": {
      "import": "./dist/mappings.js",
      "types": "./dist/mappings.d.ts"
    },
    "./detect": {
      "import": "./dist/detect.js",
      "types": "./dist/detect.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "papaparse": "^5.7.0"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "jsdom": "^30.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.33.3"
}
