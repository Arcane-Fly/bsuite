{
  "name": "@bsuite/schema-registry",
  "version": "1.0.4",
  "description": "Tenant schema, page layout, and navigation hooks for BSuite consumer apps",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Arcane-Fly/bsuite.git",
    "directory": "packages/schema-registry"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./react/editors": {
      "import": "./dist/react/editors/index.js",
      "types": "./dist/react/editors/index.d.ts"
    },
    "./server": {
      "import": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@bsuite/nav-core": ">=0.8.0 <2",
    "@supabase/supabase-js": "^2",
    "@tanstack/react-query": "^5",
    "react": ">=18 <21",
    "zod": "^4"
  },
  "devDependencies": {
    "@bsuite/nav-core": "workspace:^",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@10.33.3"
}
