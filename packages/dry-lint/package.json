{
  "name": "@bsuite/dry-lint",
  "version": "0.4.0",
  "description": "ESLint plugin enforcing BSuite one-shot architecture (single-owner Supabase entity tables) and the OAuth callback bridge contract.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/GaryOcean428/bsuite.git",
    "directory": "packages/dry-lint"
  },
  "files": [
    "dist",
    "src/ownership-map.json",
    "README.md"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ownership-map": "./src/ownership-map.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "bsuite",
    "supabase"
  ],
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@typescript-eslint/rule-tester": "^8.59.2",
    "eslint": "^9.39.4",
    "typescript": "~5.9.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.59.2"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
