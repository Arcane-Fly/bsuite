{
  "name": "@bsuite/ui",
  "version": "0.4.0",
  "type": "module",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "description": "Shared UI primitives for the BSuite apps (D2C Neon Electric + Corporate brands).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GaryOcean428/bsuite.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "src/assets"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dot-pattern": {
      "import": "./dist/dot-pattern.js",
      "types": "./dist/dot-pattern.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.js",
      "types": "./dist/utils.d.ts"
    },
    "./branding": {
      "import": "./dist/branding/index.js",
      "types": "./dist/branding/index.d.ts"
    },
    "./button": {
      "import": "./dist/button.js",
      "types": "./dist/button.d.ts"
    },
    "./dialog": {
      "import": "./dist/dialog.js",
      "types": "./dist/dialog.d.ts"
    },
    "./empty-state": {
      "import": "./dist/empty-state.js",
      "types": "./dist/empty-state.d.ts"
    },
    "./error-boundary": {
      "import": "./dist/error-boundary.js",
      "types": "./dist/error-boundary.d.ts"
    },
    "./loading-spinner": {
      "import": "./dist/loading-spinner.js",
      "types": "./dist/loading-spinner.d.ts"
    },
    "./status-badge": {
      "import": "./dist/status-badge.js",
      "types": "./dist/status-badge.d.ts"
    },
    "./assets/d2c-default-logo.svg": "./src/assets/d2c-default-logo.svg"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "clsx": "^2.1.1",
    "react-error-boundary": "^6.1.2",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@bsuite/theme": "^0.4.1",
    "@storybook/react-vite": "^10.4.2",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "storybook": "^10.4.2",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
