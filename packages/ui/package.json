{
  "name": "@bsuite/ui",
  "version": "1.3.2-next.0",
  "type": "module",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "description": "Shared UI primitives for the BSuite apps (D2C Neon Electric + Corporate brands).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arcane-Fly/bsuite.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "src/assets"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dot-pattern": {
      "import": "./dist/dot-pattern.js",
      "types": "./dist/dot-pattern.d.ts"
    },
    "./hero-grid": {
      "import": "./dist/hero-grid.js",
      "types": "./dist/hero-grid.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.js",
      "types": "./dist/utils.d.ts"
    },
    "./branding": {
      "import": "./dist/branding/index.js",
      "types": "./dist/branding/index.d.ts"
    },
    "./button": {
      "import": "./dist/button.js",
      "types": "./dist/button.d.ts"
    },
    "./dialog": {
      "import": "./dist/dialog.js",
      "types": "./dist/dialog.d.ts"
    },
    "./empty-state": {
      "import": "./dist/empty-state.js",
      "types": "./dist/empty-state.d.ts"
    },
    "./data-unavailable": {
      "import": "./dist/data-unavailable.js",
      "types": "./dist/data-unavailable.d.ts"
    },
    "./error-boundary": {
      "import": "./dist/error-boundary.js",
      "types": "./dist/error-boundary.d.ts"
    },
    "./loading-spinner": {
      "import": "./dist/loading-spinner.js",
      "types": "./dist/loading-spinner.d.ts"
    },
    "./status-badge": {
      "import": "./dist/status-badge.js",
      "types": "./dist/status-badge.d.ts"
    },
    "./command": {
      "import": "./dist/command.js",
      "types": "./dist/command.d.ts"
    },
    "./popover": {
      "import": "./dist/popover.js",
      "types": "./dist/popover.d.ts"
    },
    "./entity-selector": {
      "import": "./dist/entity-selector.js",
      "types": "./dist/entity-selector.d.ts"
    },
    "./use-on-click-outside": {
      "import": "./dist/hooks/useOnClickOutside.js",
      "types": "./dist/hooks/useOnClickOutside.d.ts"
    },
    "./assets/d2c-default-logo.svg": "./src/assets/d2c-default-logo.svg"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.47.0",
    "react-error-boundary": "^6.1.6",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "@bsuite/theme": ">=0.7.0 <2",
    "@supabase/postgrest-js": "^2",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@bsuite/theme": {
      "optional": true
    },
    "@supabase/postgrest-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bsuite/page-builder": "workspace:^",
    "@bsuite/theme": "workspace:^",
    "@storybook/react-vite": "^10.6.0",
    "@supabase/postgrest-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-grid-layout": "^2.2.4",
    "react-resizable": "^4.0.2",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
