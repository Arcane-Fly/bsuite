{
  "name": "@bsuite/ui",
  "version": "0.3.0",
  "type": "module",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "description": "Shared UI primitives for the BSuite apps (D2C Neon Electric + Corporate brands).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GaryOcean428/bsuite.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "src/assets"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dot-pattern": {
      "import": "./dist/dot-pattern.js",
      "types": "./dist/dot-pattern.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.js",
      "types": "./dist/utils.d.ts"
    },
    "./branding": {
      "import": "./dist/branding/index.js",
      "types": "./dist/branding/index.d.ts"
    },
    "./assets/d2c-default-logo.svg": "./src/assets/d2c-default-logo.svg"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "~5.9.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
