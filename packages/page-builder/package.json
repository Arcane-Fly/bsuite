{
  "name": "@bsuite/page-builder",
  "version": "2.7.1-next.3",
  "description": "Shared BSuite responsive page-builder grid and layout persistence primitives",
  "type": "module",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GaryOcean428/bsuite.git",
    "directory": "packages/page-builder"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./src/styles/react-grid-layout-overrides.css",
    "./scanner": {
      "import": "./dist/scanner/index.js",
      "types": "./dist/scanner/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:geometry": "node scripts/editor-chrome-geometry.mjs",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@bsuite/theme": ">=0.7.0 <2",
    "@dnd-kit/core": "^6",
    "@dnd-kit/sortable": "^10",
    "@dnd-kit/utilities": "^3",
    "lucide-react": ">=0.400.0",
    "react": ">=18 <21",
    "react-dom": ">=18 <21",
    "react-grid-layout": "^2",
    "react-resizable": "^3 || ^4"
  },
  "peerDependenciesMeta": {
    "@bsuite/theme": {
      "optional": true
    },
    "@dnd-kit/core": {
      "optional": true
    },
    "@dnd-kit/sortable": {
      "optional": true
    },
    "@dnd-kit/utilities": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bsuite/nav-core": "workspace:^",
    "@bsuite/theme": "workspace:^",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-grid-layout": "^2.2.4",
    "react-resizable": "^4.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.33.3"
}
