{
  "name": "@bsuite/schema-builder",
  "version": "1.9.1",
  "description": "Shared Schema Builder canvas, hooks, and Zod schemas for BSuite consumer apps (crm7, BSU, conduit, R80.3). Canonical implementation consolidating the 4 previously-duplicated React Flow schema builders, plus dagre auto-layout, crow's-foot cardinality edges, floating toolbar, inline rename (0.2.0), column-level handles, field CRUD, schema reflection RPC + PNG export (v0.3.0 = Phase 1b.2), the FieldCreateDialog component (v0.4.0 = Phase 1c), the FieldEditDialog for editing existing fields via double-click (v0.5.0 = Phase 2), migration consolidation to BSU canonical (v0.5.1 = Phase 2 prereq cleanup), Phase 3A field reorder via Alt+ArrowUp/Down with atomic sort_order RPC + aria-live announcer (v0.6.0), and Phase 3B opt-in ALTER TABLE RENAME COLUMN path with dry-run \u2192 confirm \u2192 wet-run flow and per-tenant audit log (v0.7.0).",
  "type": "module",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arcane-Fly/bsuite.git",
    "directory": "packages/schema-builder"
  },
  "files": [
    "dist",
    "supabase",
    "src/css.d.ts"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./xyflow": {
      "import": "./dist/xyflow.js",
      "types": "./dist/xyflow.d.ts"
    },
    "./auto-layout": {
      "import": "./dist/auto-layout.js",
      "types": "./dist/auto-layout.d.ts"
    },
    "./schemas": {
      "import": "./dist/schemas.js",
      "types": "./dist/schemas.d.ts"
    },
    "./hooks": {
      "import": "./dist/hooks/index.js",
      "types": "./dist/hooks/index.d.ts"
    },
    "./components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "html-to-image": "^1.11.13",
    "use-sync-external-store": "^1.7.0"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2",
    "@tanstack/react-query": "^5",
    "@xyflow/react": "^12",
    "cmdk": "^1",
    "lucide-react": ">=0.400.0",
    "react": ">=18 <21",
    "react-dom": ">=18 <21",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "cmdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.103.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12.11.6",
    "cmdk": "^1.1.1",
    "jsdom": "^30.1.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@10.33.3"
}
